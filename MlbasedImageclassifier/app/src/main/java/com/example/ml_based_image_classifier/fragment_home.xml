<?xml version="1.0" encoding="utf-8"?>
<!-- fragment_home.xml — Flood Detector: warm, human, card-based UI -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ══════════════════════════════════════
             TOP APP BAR
        ══════════════════════════════════════ -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:title="FloodWatch"
            app:titleTextAppearance="@style/TextAppearance.App.Toolbar.Title"
            app:titleTextColor="?attr/colorOnSurface"
            android:background="?attr/colorBackground"
            app:navigationIcon="@drawable/ic_waves"
            app:navigationIconTint="@color/brand_primary"/>

        <!-- ══════════════════════════════════════
             HERO GREETING CARD
        ══════════════════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="@color/brand_primary"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:text="Ready to scan?"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="Upload a satellite or aerial image to instantly detect flood coverage using on-device AI."
                    android:textSize="13sp"
                    android:textColor="#CCE4FF"
                    android:lineSpacingMultiplier="1.5"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <!-- Upload Drop Zone -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardUploadZone"
                    android:layout_width="match_parent"
                    android:layout_height="130dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="#1A66CC"
                    app:strokeColor="#3D84E8"
                    app:strokeWidth="1.5dp"
                    app:cardElevation="0dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/ivUploadIcon"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_cloud_upload"
                            app:tint="#80CFFF"
                            android:contentDescription="Upload"/>

                        <TextView
                            android:id="@+id/txtUploadHint"
                            android:text="Tap to upload image"
                            android:textSize="14sp"
                            android:textColor="#80CFFF"
                            android:fontFamily="@font/plus_jakarta_sans_medium"
                            android:layout_marginTop="8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:text="JPG, PNG · Max 10 MB"
                            android:textSize="11sp"
                            android:textColor="#4DA0E0"
                            android:layout_marginTop="2dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- Thumbnail overlaid once image is picked -->
                    <ImageView
                        android:id="@+id/ivThumbnail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        android:contentDescription="Selected image"/>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ══════════════════════════════════════
             ANALYZE BUTTON
        ══════════════════════════════════════ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnalyze"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="20dp"
            android:text="Analyze Flood Coverage"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/plus_jakarta_sans_semibold"
            android:enabled="false"
            app:backgroundTint="@color/btn_analyze_bg"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_radar"
            app:iconGravity="textStart"
            app:iconTint="#FFFFFF"
            app:iconPadding="10dp"/>

        <!-- ══════════════════════════════════════
             STATUS ROW  (shown while processing)
        ══════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/layoutStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:indeterminateTint="@color/brand_primary"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:id="@+id/txtStatus"
                android:text="Analyzing…"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- ══════════════════════════════════════
             RESULTS SECTION  (hidden until done)
        ══════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/layoutResults"
            android:visibility="gone"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="80dp">

            <!-- Section header -->
            <TextView
                android:text="Detection Results"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- Result image card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/ivResultImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Detection result"/>

                <!-- Chip overlay: severity -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSeverity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="10dp"
                    android:text="SEVERE"
                    android:textSize="11sp"
                    app:chipBackgroundColor="#CC1A1A"
                    android:textColor="#FFFFFF"
                    app:chipMinHeight="28dp"
                    app:chipCornerRadius="8dp"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── BIG COVERAGE NUMBER CARD ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:text="FLOOD COVERAGE"
                        android:textSize="11sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:letterSpacing="0.12"
                        android:fontFamily="@font/plus_jakarta_sans_medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="14dp">

                        <TextView
                            android:id="@+id/txtFloodPercentage"
                            android:text="0.00"
                            android:textSize="56sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:text="%"
                            android:textSize="26sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:fontFamily="@font/plus_jakarta_sans_medium"
                            android:layout_marginStart="4dp"
                            android:layout_marginBottom="8dp"
                            android:layout_gravity="bottom"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- Animated progress bar -->
                    <ProgressBar
                        android:id="@+id/progressFlood"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:max="100"
                        android:progress="0"
                        android:layout_marginBottom="6dp"
                        android:progressBackgroundTint="?attr/colorOutlineVariant"
                        android:progressTint="@color/brand_primary"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:text="0%"
                            android:textSize="11sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                        <TextView
                            android:text="100%"
                            android:textSize="11sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── STATS ROW CARD ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="20dp">

                    <!-- Flooded Pixels -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_water_drop"
                            app:tint="@color/brand_primary"
                            android:layout_marginBottom="6dp"
                            android:contentDescription="Flooded pixels"/>

                        <TextView
                            android:id="@+id/txtFloodedPixels"
                            android:text="--"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:text="Flooded px"
                            android:textSize="11sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:gravity="center"
                            android:layout_marginTop="2dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center_vertical"
                        android:background="?attr/colorOutlineVariant"/>

                    <!-- Total Pixels -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_grid"
                            app:tint="?attr/colorOnSurfaceVariant"
                            android:layout_marginBottom="6dp"
                            android:contentDescription="Total pixels"/>

                        <TextView
                            android:id="@+id/txtTotalPixels"
                            android:text="--"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:text="Total px"
                            android:textSize="11sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:gravity="center"
                            android:layout_marginTop="2dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center_vertical"
                        android:background="?attr/colorOutlineVariant"/>

                    <!-- AI Engine -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_chip"
                            app:tint="@color/brand_secondary"
                            android:layout_marginBottom="6dp"
                            android:contentDescription="Engine"/>

                        <TextView
                            android:text="TFLite"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:text="Engine"
                            android:textSize="11sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:gravity="center"
                            android:layout_marginTop="2dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── SAVE TO HISTORY BUTTON ── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveHistory"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:text="Save to History"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                app:strokeColor="@color/brand_primary"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_bookmark"
                app:iconGravity="textStart"
                app:iconTint="@color/brand_primary"
                app:iconPadding="10dp"/>

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
