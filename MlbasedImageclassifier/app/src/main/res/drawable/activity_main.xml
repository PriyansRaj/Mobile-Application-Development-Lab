<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E1A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="52dp"
        android:paddingBottom="32dp">

        <!-- HEADER BADGE -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_badge"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="18dp">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_dot"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI POWERED"
                android:textSize="10sp"
                android:textColor="#4FC3F7"
                android:letterSpacing="0.15"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>

        <!-- TITLE -->
        <TextView
            android:text="Flood\nDetector"
            android:textSize="44sp"
            android:textStyle="bold"
            android:textColor="#F0F4FF"
            android:lineSpacingMultiplier="0.92"
            android:letterSpacing="-0.03"
            android:layout_marginBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Upload imagery to detect and measure flood coverage with on-device AI."
            android:textSize="14sp"
            android:textColor="#4B5A78"
            android:lineSpacingMultiplier="1.55"
            android:layout_marginBottom="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- ACTION BUTTONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickImage"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:text="Upload Image"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textColor="#0A0E1A"
                app:backgroundTint="#4FC3F7"
                app:cornerRadius="16dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnalyze"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Analyze"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textColor="#4FC3F7"
                android:enabled="false"
                android:alpha="0.4"
                app:backgroundTint="#141928"
                app:strokeColor="#1E2A45"
                app:strokeWidth="1.5dp"
                app:cornerRadius="16dp"/>
        </LinearLayout>

        <!-- STATUS ROW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:visibility="gone"
                android:layout_marginEnd="10dp"
                android:indeterminateTint="#4FC3F7"/>

            <TextView
                android:id="@+id/txtStatus"
                android:text="Ready to analyze"
                android:textSize="13sp"
                android:textColor="#3D4F70"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- ORIGINAL IMAGE SECTION -->
        <LinearLayout
            android:id="@+id/layoutOriginalSection"
            android:visibility="gone"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">

            <TextView
                android:text="ORIGINAL IMAGE"
                android:textSize="11sp"
                android:textColor="#3D4F70"
                android:letterSpacing="0.12"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="220dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="#0F1525"
                app:strokeColor="#1A2540"
                app:strokeWidth="1dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/ivOriginalImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Original image"/>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- RESULT IMAGE SECTION -->
        <LinearLayout
            android:id="@+id/layoutResultSection"
            android:visibility="gone"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:text="DETECTION RESULT"
                    android:textSize="11sp"
                    android:textColor="#3D4F70"
                    android:letterSpacing="0.12"
                    android:fontFamily="sans-serif-medium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/txtResultBadge"
                    android:text="COMPLETE"
                    android:textSize="10sp"
                    android:textColor="#4FC3F7"
                    android:letterSpacing="0.08"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/bg_badge"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="240dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="#0F1525"
                app:strokeColor="#1A2540"
                app:strokeWidth="1dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/ivResultImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Detection result image"/>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- STATS CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="#0F1525"
            app:strokeColor="#1A2540"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <!-- TOP ROW: label + severity chip -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:text="FLOOD COVERAGE"
                        android:textSize="11sp"
                        android:textColor="#3D4F70"
                        android:letterSpacing="0.12"
                        android:fontFamily="sans-serif-medium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>

                    <TextView
                        android:id="@+id/txtSeverity"
                        android:text="--"
                        android:textSize="11sp"
                        android:textColor="#4FC3F7"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/bg_badge"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- BIG PERCENTAGE -->
                <TextView
                    android:id="@+id/txtFloodPercentage"
                    android:text="--.-- %"
                    android:textSize="52sp"
                    android:textStyle="bold"
                    android:textColor="#F0F4FF"
                    android:letterSpacing="-0.03"
                    android:layout_marginBottom="18dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <!-- PROGRESS BAR -->
                <ProgressBar
                    android:id="@+id/progressFlood"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:max="100"
                    android:progress="0"
                    android:layout_marginBottom="22dp"
                    android:progressBackgroundTint="#1A2540"
                    android:progressTint="#4FC3F7"/>

                <!-- DIVIDER -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#111828"
                    android:layout_marginBottom="18dp"/>

                <!-- STATS ROW -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Flooded Pixels -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:text="FLOODED PX"
                            android:textSize="10sp"
                            android:textColor="#3D4F70"
                            android:letterSpacing="0.1"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="5dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:id="@+id/txtFloodedPixels"
                            android:text="--"
                            android:textSize="16sp"
                            android:textColor="#CBD5E1"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- Vertical Divider -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center_vertical"
                        android:background="#1A2540"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"/>

                    <!-- Total Pixels -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="8dp">

                        <TextView
                            android:text="TOTAL PX"
                            android:textSize="10sp"
                            android:textColor="#3D4F70"
                            android:letterSpacing="0.1"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="5dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:id="@+id/txtTotalPixels"
                            android:text="--"
                            android:textSize="16sp"
                            android:textColor="#CBD5E1"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <!-- Vertical Divider -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center_vertical"
                        android:background="#1A2540"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"/>

                    <!-- Engine -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="8dp">

                        <TextView
                            android:text="ENGINE"
                            android:textSize="10sp"
                            android:textColor="#3D4F70"
                            android:letterSpacing="0.1"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="5dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:text="TFLite"
                            android:textSize="16sp"
                            android:textColor="#CBD5E1"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
