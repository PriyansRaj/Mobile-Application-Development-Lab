<!-- ════════════════════════════════════════════════════
     res/values/themes.xml  (Light theme, default)
════════════════════════════════════════════════════ -->
<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.FloodWatch" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Material3 color roles mapped to our palette -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#D3E4FF</item>
        <item name="colorOnPrimaryContainer">#001D36</item>

        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <item name="colorBackground">@color/bg_light</item>
        <item name="colorOnBackground">@color/on_surface_light</item>

        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/on_surface_light</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant_light</item>

        <item name="colorOutlineVariant">@color/outline_variant_light</item>

        <!-- Status + nav bar -->
        <item name="android:statusBarColor">@color/bg_light</item>
        <item name="android:navigationBarColor">@color/surface_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Bottom nav tint handled via nav_item_color selector -->
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNavigation</item>
    </style>

    <style name="Widget.App.BottomNavigation"
        parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
        <item name="android:background">?attr/colorSurface</item>
    </style>

    <style name="TextAppearance.App.Toolbar.Title"
        parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:textSize">20sp</item>
    </style>

    <!-- Analyze button: enabled vs disabled tint handled in Kotlin,
         but declare a default color state list reference -->
    <style name="Widget.App.Button.Analyze"
        parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/btn_analyze_bg</item>
        <item name="cornerRadius">16dp</item>
    </style>

</resources>

